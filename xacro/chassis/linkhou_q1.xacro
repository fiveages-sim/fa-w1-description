<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Wheel height properties -->
    <xacro:property name="drive_wheel_height" value="-0.220015"/>
    <xacro:property name="support_wheel_height" value="-0.253386"/>

    <xacro:macro name="Chassis" params="joints_movable:=true">
        <xacro:if value="${joints_movable}">
            <xacro:property name="wheel_joint_type" value="continuous"/>
        </xacro:if>
        <xacro:unless value="${joints_movable}">
            <xacro:property name="wheel_joint_type" value="fixed"/>
        </xacro:unless>

        <!-- Base Link -->
        <link name="base_footprint"/>

        <!-- Chassis Base Joint -->
        <joint name="base_footprint_joint" type="fixed">
            <parent link="base_footprint"/>
            <child link="base_link"/>
            <origin xyz="0.04 0 0.265"/>
        </joint>

        <!-- Chassis Base Link -->
        <link name="base_link">
            <inertial>
                <origin xyz="-0.0279369906854809 -0.0780315315640296 -0.140041406423673"/>
                <mass value="67.3448332441033"/>
                <inertia
                        ixx="0.665764602469938"
                        ixy="8.53793225941369E-05"
                        ixz="0.0157332917355964"
                        iyy="0.601401316135032"
                        iyz="0.000959662746039529"
                        izz="1.12756530077265"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find fiveages_w1_description)/meshes/linkhou_q1/base.glb"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="-0.025 0.0 -0.14"/>
                <geometry>
                    <box size="0.5796094 0.449 0.27073438"/>
                </geometry>
            </collision>

            <collision>
                <origin xyz="0.174732 0.119948 ${support_wheel_height}"/>
                <geometry>
                    <sphere radius="0.0374275"/>
                </geometry>
            </collision>
            <collision>
                <origin xyz="0.174732 -0.119948 ${support_wheel_height}"/>
                <geometry>
                    <sphere radius="0.0374275"/>
                </geometry>
            </collision>
            <collision>
                <origin xyz="-0.227809 0.119948 ${support_wheel_height}"/>
                <geometry>
                    <sphere radius="0.0374275"/>
                </geometry>
            </collision>
            <collision>
                <origin xyz="-0.227809 -0.119948 ${support_wheel_height}"/>
                <geometry>
                    <sphere radius="0.0374275"/>
                </geometry>
            </collision>
        </link>

        <link name="left_wheel">
            <inertial>
                <origin xyz="-3.33066907387547E-15 -0.0168546158454392 6.66133814775094E-15"/>
                <mass value="2.90416852205095"/>
                <inertia
                        ixx="0.00606418865465953"
                        ixy="-9.53834641886325E-17"
                        ixz="-3.46760179824032E-10"
                        iyy="0.0114597654254884"
                        iyz="6.73056648350715E-17"
                        izz="0.00606284887552801"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find fiveages_w1_description)/meshes/linkhou_q1/wheel.glb"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 -0.019 0" rpy="1.5708 0 0"/>
                <geometry>
                    <cylinder radius="0.07585" length="0.036"/>
                </geometry>
            </collision>
        </link>

        <joint name="chassis_left_joint" type="${wheel_joint_type}">
            <origin xyz="-0.026651 0.20625 ${drive_wheel_height}"/>
            <parent link="base_link"/>
            <child link="left_wheel"/>
            <xacro:if value="${joints_movable}">
                <axis xyz="0 1 0"/>
            </xacro:if>
        </joint>

        <link name="right_wheel">
            <inertial>
                <origin xyz="4.21884749357559E-15 0.0168546158454395 5.99520433297585E-15"/>
                <mass value="2.90416852205097"/>
                <inertia
                        ixx="0.00606417635990965"
                        ixy="-8.96010303184599E-17"
                        ixz="-1.27754486123426E-07"
                        iyy="0.0114597654254885"
                        iyz="-4.98533610134315E-17"
                        izz="0.00606286117027795"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find fiveages_w1_description)/meshes/linkhou_q1/wheel.glb" scale="1 -1 1"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0.019 0" rpy="1.5708 0 0"/>
                <geometry>
                    <cylinder radius="0.07585" length="0.036"/>
                </geometry>
            </collision>
        </link>

        <joint name="chassis_right_joint" type="${wheel_joint_type}">
            <origin xyz="-0.026651 -0.20625 ${drive_wheel_height}"/>
            <parent link="base_link"/>
            <child link="right_wheel"/>
            <xacro:if value="${joints_movable}">
                <axis xyz="0 1 0"/>
            </xacro:if>
        </joint>

        <link name="scan"/>
        <joint name="scan_link" type="fixed">
            <parent link="base_link"/>
            <child link="scan"/>
            <origin xyz="0.18785 0 -0.089789"/>
        </joint>

        <link name="imu"/>
        <joint name="imu_link" type="fixed">
            <parent link="base_footprint"/>
            <child link="imu"/>
            <origin xyz="0 0 0.13"/>
        </joint>


    </xacro:macro>
</robot>
