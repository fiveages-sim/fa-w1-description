<?xml version="1.0" ?>
<!-- =================================================================================== -->
<!-- |    Complete Robot Description for Agibot G1                                     | -->
<!-- |    This file includes the base robot structure and both arms                    | -->
<!-- =================================================================================== -->
<robot name="FiveAges_W1" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="type" default="base"/>

	<xacro:if value="${'$(arg type)' == 'base'}">
		<xacro:include filename="$(find fiveages_w1_description)/xacro/chassis/chassis.xacro"/>
		<xacro:Chassis />
	</xacro:if>

	<xacro:if value="${'$(arg type)' == 'linkhou_q1'}">
		<xacro:include filename="$(find fiveages_w1_description)/xacro/chassis/linkhou_q1.xacro"/>
		<xacro:Chassis />
	</xacro:if>

	<xacro:if value="${'$(arg type)' == 'upper_body'}">
		<xacro:include filename="$(find fiveages_w1_description)/xacro/body.xacro"/>
		<link name="base_link"/>
		<xacro:Body/>
	</xacro:if>

</robot>
