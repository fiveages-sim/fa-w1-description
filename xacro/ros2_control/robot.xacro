<?xml version="1.0"?>
<robot name="fiveages_w1" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="ros2_control_hardware_type" default="mock_components"/>


    <!-- 直接include robot.xacro并根据type参数传递 -->
    <xacro:include filename="$(find fiveages_w1_description)/xacro/robot.xacro"/>

    <xacro:include filename="$(find rokae_ar5_description)/xacro/ros2_control/interfaces.xacro"/>
    <xacro:include filename="$(find fiveages_w1_description)/xacro/ros2_control/body.xacro"/>
    <xacro:include filename="$(find fiveages_w1_description)/xacro/ros2_control/chassis.xacro"/>

    <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <ros2_control name="ar5_left_system" type="system">
            <hardware>
                <plugin>rokae_ros2_control/RokaeHardware</plugin>
                <param name="arm_ip">192.168.2.160</param>
                <param name="joint_impedance">500,500,500,500,50,50,50</param>
                <param name="local_ip">192.168.2.100</param>
            </hardware>
            <xacro:ar5_interfaces name="left"/>
            <xacro:if value="${'$(arg type)' == 'rg75'}">
                <joint name="left_gripper_joint">
                    <command_interface name="position"/>
                    <state_interface name="position">
                        <param name="initial_value">0</param>
                    </state_interface>
                </joint>
            </xacro:if>
        </ros2_control>
        <ros2_control name="ar5_right_system" type="system">
            <hardware>
                <plugin>rokae_ros2_control/RokaeHardware</plugin>
                <param name="arm_ip">192.168.2.161</param>
                <param name="joint_impedance">500,500,500,500,50,50,50</param>
                <param name="local_ip">192.168.2.100</param>
            </hardware>
            <xacro:ar5_interfaces name="right"/>
            <xacro:if value="${'$(arg type)' == 'rg75'}">
                <joint name="right_gripper_joint">
                    <command_interface name="position"/>
                    <state_interface name="position">
                        <param name="initial_value">0</param>
                    </state_interface>
                </joint>
            </xacro:if>
        </ros2_control>

        <ros2_control name="eyou_body" type="system">
            <hardware>
                <plugin>eyou_ros2_control/EyouHardware</plugin>
                <param name="device_type">Canable</param>
                <param name="device_index">2 </param>
                <param name="baudrate">1000</param>
                <param name="motor_ids">[1, 2, 3, 4, 5, 6]</param>
                <param name="control_period_ms">4</param>
                <param name="report_period_ms">100</param>
                <param name="use_sync">true</param>

                <!-- 每个电机的减速比配置 -->
                <param name="reduction_ratios">[121.0, 121.0, 121.0, 121.0, 56.0, 36.0]</param>
            </hardware>

            <xacro:body_interfaces/>
        </ros2_control>

        <ros2_control name="virtual_system" type="system">
            <hardware>
                <plugin>mock_components/GenericSystem</plugin>
            </hardware>
            <xacro:chassis_interfaces/>
        </ros2_control>
    </xacro:if>

    <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real-laptop'}">
        <ros2_control name="ar5_left_system" type="system">
            <hardware>
                <plugin>rokae_ros2_control/RokaeHardware</plugin>
                <param name="arm_ip">192.168.2.160</param>
<!--                <param name="joint_impedance">500,500,500,500,50,50,50</param>-->
                <param name="local_ip">192.168.2.233</param>
            </hardware>
            <xacro:ar5_interfaces name="left"/>
            <xacro:if value="${'$(arg type)' == 'rg75'}">
                <joint name="left_gripper_joint">
                    <command_interface name="position"/>
                    <state_interface name="position">
                        <param name="initial_value">0</param>
                    </state_interface>
                </joint>
            </xacro:if>
        </ros2_control>
        <ros2_control name="ar5_right_system" type="system">
            <hardware>
                <plugin>rokae_ros2_control/RokaeHardware</plugin>
                <param name="arm_ip">192.168.2.161</param>
                <param name="joint_impedance">500,500,500,500,50,50,50</param>
                <param name="local_ip">192.168.2.233</param>
            </hardware>
            <xacro:ar5_interfaces name="right"/>
            <xacro:if value="${'$(arg type)' == 'rg75'}">
                <joint name="right_gripper_joint">
                    <command_interface name="position"/>
                    <state_interface name="position">
                        <param name="initial_value">0</param>
                    </state_interface>
                </joint>
            </xacro:if>
        </ros2_control>

        <ros2_control name="eyou_body" type="system">
            <hardware>
                <plugin>eyou_ros2_control/EyouHardware</plugin>
                <param name="device_type">Canable</param>
                <param name="device_index">0</param>
                <param name="baudrate">1000</param>
                <param name="motor_ids">[1, 2, 3, 4, 5, 6]</param>
                <param name="control_period_ms">4</param>
                <param name="report_period_ms">100</param>
                <param name="use_sync">true</param>

                <!-- 每个电机的减速比配置 -->
                <param name="reduction_ratios">[121.0, 121.0, 121.0, 121.0, 56.0, 36.0]</param>
            </hardware>

            <xacro:body_interfaces/>
        </ros2_control>

        <ros2_control name="virtual_system" type="system">
            <hardware>
                <plugin>mock_components/GenericSystem</plugin>
            </hardware>
            <xacro:chassis_interfaces/>
        </ros2_control>
    </xacro:if>

    <xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <xacro:unless value="${'$(arg ros2_control_hardware_type)' == 'real-laptop'}">
        <ros2_control name="fiveages_w1_system" type="system">
            <hardware>
                <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
                    <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
                    <param name="joint_commands_topic">/isaac/joint_command</param>
                    <param name="joint_states_topic">/isaac/joint_states</param>
                    <param name="sum_wrapped_joint_states">false</param>
                    <param name="initialize_commands_from_state">true</param>
                </xacro:if>
            </hardware>

            <xacro:chassis_interfaces/>
            <xacro:body_interfaces/>
            <xacro:ar5_interfaces name="left"/>
            <xacro:ar5_interfaces name="right"/>

            <xacro:if value="${'$(arg type)' == 'rg75' or '$(arg type)' == 'leapmotor' or '$(arg type)' == 'linkhou_rg75' or '$(arg type)' == 'linkhou_leapmotor'}">
                <xacro:include filename="$(find jodell_description)/xacro/ros2_control/RG75-300.xacro"/>
                <xacro:rg75_interfaces name="left"/>
                <xacro:rg75_interfaces name="right"/>
            </xacro:if>
        </ros2_control>
        </xacro:unless>
    </xacro:unless>

    <!-- Gazebo plugin configuration -->
    <xacro:arg name="gazebo" default="false"/>
    <xacro:if value="$(arg gazebo)">
        <xacro:property name="ros2_control_config_basename" value="ros2_controllers.yaml"/>

        <xacro:if value="${type_arg == 'rg75'}">
            <xacro:property name="ros2_control_config_basename" value="rg75.yaml"/>
        </xacro:if>

        <xacro:if value="${type_arg == 'leapmotor'}">
            <xacro:property name="ros2_control_config_basename" value="leapmotor.yaml"/>
        </xacro:if>

        <xacro:if value="${type_arg == 'linkhou_rg75'}">
            <xacro:property name="ros2_control_config_basename" value="linkhou_rg75.yaml"/>
        </xacro:if>

        <xacro:if value="${type_arg == 'linkhou_leapmotor'}">
            <xacro:property name="ros2_control_config_basename" value="linkhou_leapmotor.yaml"/>
        </xacro:if>

        <gazebo>
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find fiveages_w1_description)/config/ros2_control/${ros2_control_config_basename}</parameters>
            </plugin>
        </gazebo>
        <xacro:include filename="$(find fiveages_w1_description)/xacro/gazebo.xacro"/>
    </xacro:if>
</robot>
