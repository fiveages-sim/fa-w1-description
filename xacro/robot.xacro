<?xml version="1.0"?>
<robot name="FiveAges W1" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!-- Arguments -->
	<xacro:arg name="type" default=""/>
	<xacro:arg name="collider" default="convex"/>

	<!-- Select chassis, arm & gripper based on type -->
	<xacro:property name="type_arg" value="$(arg type)"/>
	<xacro:property name="selected_chassis" value="chassis"/>
	<xacro:property name="selected_arm" value="srs"/>
	<xacro:property name="selected_gripper_type" value="${type_arg}"/>

	<xacro:if value="${type_arg == 'linkhou_ccs_rg75'}">
		<xacro:property name="selected_chassis" value="linkhou_q1"/>
		<xacro:property name="selected_arm" value="ccs"/>
		<xacro:property name="selected_gripper_type" value="rg75"/>
	</xacro:if>

	<xacro:if value="${type_arg == 'linkhou_srs_rg75'}">
		<xacro:property name="selected_chassis" value="linkhou_q1"/>
		<xacro:property name="selected_arm" value="srs"/>
		<xacro:property name="selected_gripper_type" value="rg75"/>
	</xacro:if>

	<xacro:if value="${type_arg == 'linkhou_ccs_leapmotor'}">
		<xacro:property name="selected_chassis" value="linkhou_q1"/>
		<xacro:property name="selected_arm" value="ccs"/>
		<xacro:property name="selected_gripper_type" value="leapmotor"/>
	</xacro:if>

	<xacro:if value="${type_arg == 'linkhou_srs_leapmotor'}">
		<xacro:property name="selected_chassis" value="linkhou_q1"/>
		<xacro:property name="selected_arm" value="srs"/>
		<xacro:property name="selected_gripper_type" value="leapmotor"/>
	</xacro:if>

	<!-- Default chassis configurations -->
	<xacro:if value="${type_arg == 'ccs_rg75'}">
		<xacro:property name="selected_chassis" value="chassis"/>
		<xacro:property name="selected_arm" value="ccs"/>
		<xacro:property name="selected_gripper_type" value="rg75"/>
	</xacro:if>

	<xacro:if value="${type_arg == 'ccs_leapmotor'}">
		<xacro:property name="selected_chassis" value="chassis"/>
		<xacro:property name="selected_arm" value="ccs"/>
		<xacro:property name="selected_gripper_type" value="leapmotor"/>
	</xacro:if>

	<xacro:if value="${type_arg == 'srs_rg75'}">
		<xacro:property name="selected_chassis" value="chassis"/>
		<xacro:property name="selected_arm" value="srs"/>
		<xacro:property name="selected_gripper_type" value="rg75"/>
	</xacro:if>

	<xacro:if value="${type_arg == 'srs_leapmotor'}">
		<xacro:property name="selected_chassis" value="chassis"/>
		<xacro:property name="selected_arm" value="srs"/>
		<xacro:property name="selected_gripper_type" value="leapmotor"/>
	</xacro:if>

	<!-- Include Component Macros -->
	<xacro:include filename="$(find fiveages_w1_description)/xacro/chassis/${selected_chassis}.xacro"/>
	<xacro:include filename="$(find fiveages_w1_description)/xacro/body.xacro"/>
	<xacro:include filename="$(find fiveages_w1_description)/xacro/grippers.xacro"/>

	<!-- Include Arm based on selected_arm -->
	<xacro:if value="${selected_arm == 'ccs'}">
		<xacro:include filename="$(find rokae_ar5_description)/xacro/arm_ccs.xacro"/>
	</xacro:if>
	<xacro:if value="${selected_arm == 'srs'}">
		<xacro:include filename="$(find rokae_ar5_description)/xacro/arm_srs.xacro"/>
	</xacro:if>

	<!-- Chassis -->
	<xacro:Chassis/>

	<!-- Body -->
	<xacro:Body collider="$(arg collider)"/>

	<link name="arm_base"/>

	<joint name="arm_base_joint" type="fixed">
		<parent link="body_link4"/>
		<child link="arm_base"/>
		<origin xyz="0.0 0.0 0.41"/>
	</joint>

	<joint name="left_arm_mount" type="fixed">
		<parent link="arm_base"/>
		<child link="left_base_link"/>
		<origin xyz="0.0 0.12 0" rpy="-1.57 1.57 0"/>
	</joint>

	<joint name="right_arm_mount" type="fixed">
		<parent link="arm_base"/>
		<child link="right_base_link"/>
		<origin xyz="0.0 -0.12 0" rpy="1.57 1.57 0"/>
	</joint>

	<!-- Arms -->
	<xacro:Arm name="left" collider="$(arg collider)" direction="1"/>
	<xacro:Arm name="right" collider="$(arg collider)" direction="-1"/>

	<xacro:Grippers type="${selected_gripper_type}"/>
</robot>