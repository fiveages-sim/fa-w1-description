<?xml version="1.0"?>
<robot name="FiveAges W1" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="PI" value="3.1415926535897931"/>
    <!-- topology:
         full (default) = chassis + body/head + dual AR5
         dual           = split_body planning URDF (same layout as m6_ccs / WCE3):
                          empty base_link is the URDF root; arm_base is OCS2 baseFrame
                          and carries the W1 chest box. Flange ±0.12. -->
    <xacro:arg name="topology" default="full"/>
    <xacro:arg name="collider" default="simple"/>
    <!-- Native W1 chassis, or Linkhou Q1. Independent from the dual-arm kit. -->
    <xacro:arg name="chassis" default="w1"/>
    <!-- Same as W2: freeze wheels on the full robot. Component preview defaults to true. -->
    <xacro:arg name="chassis_joints_movable" default="false"/>
    <!-- Dual-arm kit: AR5 CCS v1 or AR5 SRS. CCS v2 is not used on W1. -->
    <xacro:arg name="arms" default="ar5_srs"/>

    <!-- End-effector selection:
         - type is the symmetric default.
         - left_type/right_type can override each side independently.
         - eef_fixed_joints is used by OCS2 planning URDF generation. -->
    <xacro:arg name="type" default=""/>
    <xacro:arg name="left_type" default=""/>
    <xacro:arg name="right_type" default=""/>
    <xacro:arg name="eef_fixed_joints" default="false"/>
    <xacro:arg name="left_tcp_offset_xyz" default="0 0 0"/>
    <xacro:arg name="left_tcp_offset_rpy" default="0 0 0"/>
    <xacro:arg name="right_tcp_offset_xyz" default="0 0 0"/>
    <xacro:arg name="right_tcp_offset_rpy" default="0 0 0"/>
    <xacro:property name="topology_arg" value="$(arg topology)"/>
    <xacro:property name="type_arg" value="$(arg type)"/>
    <xacro:property name="left_type_arg" value="$(arg left_type)"/>
    <xacro:property name="right_type_arg" value="$(arg right_type)"/>
    <xacro:property name="effective_left_type" value="${left_type_arg if left_type_arg != '' else type_arg}"/>
    <xacro:property name="effective_right_type" value="${right_type_arg if right_type_arg != '' else type_arg}"/>

    <xacro:include filename="$(find ar5_ccs_description)/xacro/eef_type_resolver.xacro"/>
    <xacro:set_side_eef_types side="left" type_key="${effective_left_type}"/>
    <xacro:set_side_eef_types side="right" type_key="${effective_right_type}"/>

    <xacro:property name="selected_hand_type" value="${left_hand_type if left_hand_type == right_hand_type else ''}"/>
    <xacro:property name="selected_gripper_type" value="${left_gripper_type if left_gripper_type == right_gripper_type else ''}"/>
    <xacro:property name="selected_gripper_pad" value="${left_gripper_pad if left_gripper_pad == right_gripper_pad else 'default'}"/>

    <!-- CCS and SRS share the W1 flange (±0.12), not the CCS pedestal ±0.062. -->
    <xacro:if value="${topology_arg == 'dual'}">
        <link name="base_link"/>
        <!-- body_link4 simple box (origin 0.0091 0 0.256, size 0.2509 0.35 0.5029)
             expressed in arm_base (body_link4 → arm_base z=+0.41). -->
        <link name="arm_base">
            <collision>
                <origin xyz="0.0091 0 -0.154"/>
                <geometry>
                    <box size="0.2509 0.35 0.5029"/>
                </geometry>
            </collision>
        </link>
        <joint name="arm_base_joint" type="fixed">
            <parent link="base_link"/>
            <child link="arm_base"/>
        </joint>
        <joint name="left_arm_mount" type="fixed">
            <parent link="arm_base"/>
            <child link="left_base_link"/>
            <origin xyz="0.0 0.12 0" rpy="-${PI/2} ${PI/2} 0"/>
        </joint>
        <joint name="right_arm_mount" type="fixed">
            <parent link="arm_base"/>
            <child link="right_base_link"/>
            <origin xyz="0.0 -0.12 0" rpy="${PI/2} ${PI/2} 0"/>
        </joint>
    </xacro:if>

    <xacro:unless value="${topology_arg == 'dual'}">
        <xacro:property name="chassis_arg" value="$(arg chassis)"/>
        <xacro:if value="${chassis_arg == 'w1'}">
            <xacro:include filename="$(find fiveages_w1_description)/xacro/chassis/chassis.xacro"/>
            <xacro:Chassis joints_movable="$(arg chassis_joints_movable)"/>
        </xacro:if>
        <xacro:if value="${chassis_arg == 'linkhou_q1'}">
            <xacro:include filename="$(find fiveages_w1_description)/xacro/chassis/linkhou_q1.xacro"/>
            <xacro:Chassis joints_movable="$(arg chassis_joints_movable)"/>
        </xacro:if>

        <xacro:include filename="$(find fiveages_w1_description)/xacro/body.xacro"/>
        <xacro:Body collider="$(arg collider)"/>

        <joint name="left_arm_mount" type="fixed">
            <parent link="arm_base"/>
            <child link="left_base_link"/>
            <origin xyz="0.0 0.12 0" rpy="-${PI/2} ${PI/2} 0"/>
        </joint>
        <joint name="right_arm_mount" type="fixed">
            <parent link="arm_base"/>
            <child link="right_base_link"/>
            <origin xyz="0.0 -0.12 0" rpy="${PI/2} ${PI/2} 0"/>
        </joint>
    </xacro:unless>

    <xacro:if value="${'$(arg arms)' == 'ar5_ccs'}">
        <xacro:include filename="$(find ar5_ccs_description)/xacro/arm_ccs.xacro"/>
        <xacro:AR5_CCS name="left" direction="1" collider="$(arg collider)"/>
        <xacro:AR5_CCS name="right" direction="-1" collider="$(arg collider)"/>
    </xacro:if>
    <xacro:if value="${'$(arg arms)' == 'ar5_srs'}">
        <xacro:include filename="$(find ar5_srs_description)/xacro/arm_srs.xacro"/>
        <xacro:Arm name="left" direction="1" collider="$(arg collider)"/>
        <xacro:Arm name="right" direction="-1" collider="$(arg collider)"/>
    </xacro:if>

    <link name="left_tcp_offset"/>
    <joint name="left_tcp_offset_joint" type="fixed">
        <parent link="left_tcp"/>
        <child link="left_tcp_offset"/>
        <origin xyz="$(arg left_tcp_offset_xyz)" rpy="$(arg left_tcp_offset_rpy)"/>
    </joint>
    <link name="right_tcp_offset"/>
    <joint name="right_tcp_offset_joint" type="fixed">
        <parent link="right_tcp"/>
        <child link="right_tcp_offset"/>
        <origin xyz="$(arg right_tcp_offset_xyz)" rpy="$(arg right_tcp_offset_rpy)"/>
    </joint>

    <xacro:if value="${effective_left_type == 'robotiq85' or effective_right_type == 'robotiq85'}">
        <xacro:include filename="$(find fiveages_w1_description)/xacro/grippers.xacro"/>
        <xacro:Grippers type="robotiq85"/>
    </xacro:if>
    <xacro:unless value="${effective_left_type == 'robotiq85' or effective_right_type == 'robotiq85'}">
        <xacro:include filename="$(find ar5_ccs_description)/xacro/eefs.xacro"/>
        <xacro:EndEffectors
            eef_fixed_joints="$(arg eef_fixed_joints)"
            left_hand_type="${left_hand_type}"
            left_gripper_type="${left_gripper_type}"
            left_gripper_pad="${left_gripper_pad}"
            right_hand_type="${right_hand_type}"
            right_gripper_type="${right_gripper_type}"
            right_gripper_pad="${right_gripper_pad}"/>
    </xacro:unless>
</robot>
