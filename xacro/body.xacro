<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="Body" params="collider:=convex">

        <!-- Trunk Base Link -->
        <link name="trunk_base_link">
            <inertial>
                <origin xyz="-3.32739807928917E-11 0.00108475904249383 0.0646969570751819"/>
                <mass value="5.2916725383757"/>
                <inertia
                        ixx="0.0204718891237549"
                        ixy="4.85115711850459E-12"
                        ixz="-6.41065846332626E-12"
                        iyy="0.0225397707546832"
                        iyz="-0.000166583637729049"
                        izz="0.014637715325779"/>
            </inertial>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find fiveages_w1_description)/meshes/body/base.obj"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <!-- Trunk Base Joint -->
        <joint name="trunk_base_link_Joint" type="fixed">
            <parent link="base_link"/>
            <child link="trunk_base_link"/>
            <axis xyz="0 1 0"/>
            <origin xyz="-0.0725 0 0"/>
        </joint>

        <!-- Trunk Link 1 -->
        <link name="body_link1">
            <inertial>
                <origin xyz="-2.00192633256768E-06 0.037648370852891 0.229389705349819"/>
                <mass value="6.12532979899165"/>
                <inertia
                        ixx="0.107502593877351"
                        ixy="-4.33428423533899E-07"
                        ixz="1.55820301705163E-06"
                        iyy="0.105834274643522"
                        iyz="0.000834756143947899"
                        izz="0.0138000958638935"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find fiveages_w1_description)/meshes/body/link1.obj"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find fiveages_w1_description)/meshes/body/link1.obj"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="body_joint1" type="revolute">
            <origin xyz="0 -0.0393 0.112"/>
            <parent link="trunk_base_link"/>
            <child link="body_link1"/>
            <axis xyz="0 1 0"/>
            <limit lower="0" upper="1.504" effort="300" velocity="15"/>
            <dynamics damping="0.01" friction="0.1"/>
        </joint>

        <link name="body_link2">
            <inertial>
                <origin xyz="6.93889390390723E-17 0.0527983940700079 0.181464564928581"/>
                <mass value="4.75279692361668"/>
                <inertia
                        ixx="0.0610885753910733"
                        ixy="-1.19536966653269E-18"
                        ixz="-7.76730748312509E-18"
                        iyy="0.0529989544087246"
                        iyz="-0.00179309730212265"
                        izz="0.0201482952717101"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find fiveages_w1_description)/meshes/body/link2.obj"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find fiveages_w1_description)/meshes/body/link2.obj"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="body_joint2" type="revolute">
            <origin xyz="0 -0.013 0.327"/>
            <parent link="body_link1"/>
            <child link="body_link2"/>
            <axis xyz="0 1 0"/>
            <limit lower="-2.5" upper="2.5" effort="300" velocity="15"/>
            <dynamics damping="0.01" friction="0.1"/>
        </joint>

        <link name="body_link3">
            <inertial>
                <origin xyz="1.69489079715479E-09 -0.0494999971490837 0.0299182901675204"/>
                <mass value="1.40110394589238"/>
                <inertia
                        ixx="0.0039279902713771"
                        ixy="-9.37102716068198E-12"
                        ixz="1.60664128414939E-11"
                        iyy="0.00456822897709997"
                        iyz="-9.20676483539881E-11"
                        izz="0.00233089385500014"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find fiveages_w1_description)/meshes/body/link3.obj"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find fiveages_w1_description)/meshes/body/link3.obj"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="body_joint3" type="revolute">
            <origin xyz="0 0.1018 0.255"/>
            <parent link="body_link2"/>
            <child link="body_link3"/>
            <axis xyz="0 -1 0"/>
            <limit lower="-3.14" upper="0" effort="300" velocity="15"/>
            <dynamics damping="0.01" friction="0.1"/>
        </joint>

        <link name="body_link4">
            <inertial>
                <origin xyz="-0.00657929165109954 2.61392266098781E-06 0.218245992580224"/>
                <mass value="4.66047184585229"/>
                <inertia
                        ixx="0.0788874639537613"
                        ixy="5.46530938736686E-10"
                        ixz="0.00286825206797472"
                        iyy="0.0515041942141216"
                        iyz="3.46275348004213E-07"
                        izz="0.0448953474115628"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find fiveages_w1_description)/meshes/body/link4.obj"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find fiveages_w1_description)/meshes/body/link4.obj"/>
                    </geometry>
                </collision>
            </xacro:if>
            <xacro:if value="${collider == 'simple'}">
                <collision>
                    <origin xyz="0.0091 0 0.256"/>
                    <geometry>
                        <box size="0.2509 0.35 0.5029"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="body_joint4" type="revolute">
            <origin xyz="0 -0.0495 0.1005"/>
            <parent link="body_link3"/>
            <child link="body_link4"/>
            <axis xyz="0 0 1"/>
            <limit lower="-3.14" upper="3.14" effort="300" velocity="15"/>
            <dynamics damping="0.01" friction="0.1"/>
        </joint>

        <link name="head_link1">
            <inertial>
                <origin xyz="-0.00027121 1.4012E-05 0.031017"/>
                <mass value="0.25094"/>
                <inertia
                        ixx="6.0757E-05"
                        ixy="-1.1281E-09"
                        ixz="3.8393E-07"
                        iyy="4.1675E-05"
                        iyz="1.0479E-09"
                        izz="6.523E-05"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find fiveages_w1_description)/meshes/body/head1.obj"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find fiveages_w1_description)/meshes/body/head1.obj"/>
                    </geometry>
                </collision>
            </xacro:if>
            <xacro:if value="${collider == 'simple'}">
                <collision>
                    <origin xyz="0.0003 0.0000 -0.0100"/>
                    <geometry>
                        <box size="0.0500 0.0500 0.0401"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="head_joint1" type="revolute">
            <origin xyz="-0.02258 0 0.485317"/>
            <parent link="body_link4"/>
            <child link="head_link1"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.57" upper="1.57" effort="15" velocity="15"/>
            <dynamics damping="0.01" friction="0.1"/>
        </joint>

        <link name="head_link2">
            <inertial>
                <origin xyz="0.02 0 0.093841"/>
                <mass value="1.2686"/>
                <inertia
                        ixx="0.0042697"
                        ixy="-4.6785E-20"
                        ixz="-5.4624E-19"
                        iyy="0.0031772"
                        iyz="2.312E-19"
                        izz="0.0013394"/>
            </inertial>
            <visual>
                <geometry>
                    <mesh filename="file://$(find fiveages_w1_description)/meshes/body/head2.obj"/>
                </geometry>
            </visual>
            <xacro:if value="${collider == 'convex'}">
                <collision>
                    <geometry>
                        <mesh filename="file://$(find fiveages_w1_description)/meshes/body/head2.obj"/>
                    </geometry>
                </collision>
            </xacro:if>
            <xacro:if value="${collider == 'simple'}">
                <collision>
                    <origin xyz="0.0366 0 0.08"/>
                    <geometry>
                        <box size="0.1813 0.1640 0.2230"/>
                    </geometry>
                </collision>
            </xacro:if>
        </link>

        <joint name="head_joint2" type="revolute">
            <origin xyz="0 0 0.033543"/>
            <parent link="head_link1"/>
            <child link="head_link2"/>
            <axis xyz="0 -1 0"/>
            <limit lower="-1.57" upper="1.57" effort="15" velocity="15"/>
            <dynamics damping="0.01" friction="0.1"/>
        </joint>

        <link name="arm_base"/>

        <joint name="arm_base_joint" type="fixed">
            <parent link="body_link4"/>
            <child link="arm_base"/>
            <origin xyz="0.0 0.0 0.41"/>
        </joint>


    </xacro:macro>
</robot>
